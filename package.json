{
  "name": "modipdfy",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first browser PDF editor scaffold",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "dev": "npm run build:wasm && node scripts/serve.mjs web",
    "build:wasm": "wasm-pack build crates/modipdfy-wasm --target web --release --out-dir ../../web/pkg --out-name modipdfy_wasm --no-pack",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:wasm && npm run build:web",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/serve.mjs dist"
  }
}
